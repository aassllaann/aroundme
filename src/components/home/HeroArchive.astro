---
import SiteNav from '../layout/SiteNav.astro';
---

<main class="archive-home">
  <header class="home-header">
    <p class="edition-mark">ARCHIVE / 01</p>
    <SiteNav current="index" />
    <p class="edition-mark edition-mark--right">SINGAPORE / 2026</p>
  </header>

  <section class="hero" aria-labelledby="hero-title">
    <p class="hero-note hero-note--left">VISUAL SYSTEMS<br />IN UNFINISHED ROOMS</p>

    <h1 id="hero-title" class="hero-title">
      <span>LI YETONG</span>
      <span>PORTFOLIO</span>
    </h1>

    <img
      class="archive-symbol"
      src="images/site/archive-symbol-placeholder.svg"
      alt="Abstract archive symbol placeholder"
      width="420"
      height="420"
    />

    <p class="hero-note hero-note--right">SMALL MACHINES<br />FOR STRANGE STORIES</p>
  </section>

  <footer class="home-footer">
    <p class="identity">CREATIVE TECHNOLOGIST<br />AI · ARCHIVES · INTERACTION</p>
    <p class="intro">A working archive of visual systems,<br />unfinished cases, and small machines.</p>
    <a class="enter-link" href="/works">ENTER THE WORKS <span aria-hidden="true">↗</span></a>
  </footer>
</main>
