---
import SiteNav from '../layout/SiteNav.astro';
---

<section id="index" class="poster-page" aria-labelledby="poster-title">
  <header class="poster-nav">
    <a class="poster-nav__name" href="/" aria-label="Li Yetong, home">LI YETONG / ASLAN</a>
    <SiteNav current="index" worksHref="#works" showIndex={false} />
  </header>

  <section class="poster-cover" aria-labelledby="poster-title">
    <div class="poster-cover__planes" aria-hidden="true">
      <span class="poster-cover__red"></span>
      <span class="poster-cover__yellow"></span>
      <svg class="poster-cover__liquid" data-liquid-fields viewBox="0 0 1000 700" preserveAspectRatio="none" focusable="false">
        <path data-liquid-red fill="#E5483B" d="M 0 0 L 680 0 L 680 588 L 0 588 Z"></path>
        <path data-liquid-yellow fill="#DDF000" stroke="#FDF9F2" stroke-width="8" vector-effect="non-scaling-stroke" d="M 620 168 L 1000 168 L 1000 700 L 620 700 Z"></path>
      </svg>
    </div>

    <p class="poster-cover__eyebrow">CREATIVE TECHNOLOGIST<br />SINGAPORE / 2026</p>

    <h1 id="poster-title" class="poster-cover__name" aria-label="Li Yetong">
      <span>LI</span>
      <span>YETONG</span>
    </h1>

    <p class="poster-cover__statement">
      Working between AI, interaction,<br />visual systems and narrative.
    </p>

    <a class="poster-cover__action" href="#works">
      <span>VIEW WORKS</span><span aria-hidden="true">↓</span>
    </a>
  </section>

  <footer class="poster-footer">
    <a href="mailto:YETONG001@e.ntu.edu.sg">YETONG001@e.ntu.edu.sg ↗</a>
    <a href="https://github.com/aassllaann" target="_blank" rel="noreferrer">GITHUB / AASSLLAANN ↗</a>
  </footer>
</section>

<script>
  import { liquidRectPath, staticRectPath } from '../../scripts/liquid-fields.js';

  const cover = document.querySelector<HTMLElement>('.poster-cover');
  const svg = document.querySelector<SVGSVGElement>('[data-liquid-fields]');
  const redPath = document.querySelector<SVGPathElement>('[data-liquid-red]');
  const yellowPath = document.querySelector<SVGPathElement>('[data-liquid-yellow]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (cover && svg && redPath && yellowPath && !reduceMotion) {
    const liquidCover = cover;
    const liquidSvg = svg;
    const liquidRed = redPath;
    const liquidYellow = yellowPath;
    const current = { x: 500, y: 350 };
    const target = { x: 500, y: 350 };
    let strength = 0;
    let hovering = false;
    let pulseUntil = 0;
    let frame = 0;
    let visible = true;
    let touchStart: { x: number; y: number; time: number } | undefined;
    let redRect = { x: 0, y: 0, width: 680, height: 588 };
    let yellowRect = { x: 620, y: 168, width: 380, height: 532 };

    function setResponsiveGeometry() {
      if (window.matchMedia('(max-width: 700px)').matches) {
        redRect = { x: 0, y: 0, width: 1000, height: 406 };
        yellowRect = { x: 280, y: 371, width: 720, height: 329 };
      } else {
        redRect = { x: 0, y: 0, width: 680, height: 588 };
        yellowRect = { x: 620, y: 168, width: 380, height: 532 };
      }
      liquidRed.setAttribute('d', staticRectPath(redRect));
      liquidYellow.setAttribute('d', staticRectPath(yellowRect));
    }

    function pointerPosition(event: PointerEvent) {
      const bounds = liquidSvg.getBoundingClientRect();
      if (!bounds.width || !bounds.height) return;
      target.x = (event.clientX - bounds.left) / bounds.width * 1000;
      target.y = (event.clientY - bounds.top) / bounds.height * 700;
    }

    function render() {
      liquidRed.setAttribute('d', liquidRectPath(redRect, current, strength));
      liquidYellow.setAttribute('d', liquidRectPath(yellowRect, current, strength));
    }

    function wake() {
      if (visible && !frame) frame = requestAnimationFrame(tick);
    }

    function tick(time: number) {
      const desiredStrength = hovering || time < pulseUntil ? 1 : 0;
      current.x += (target.x - current.x) * .16;
      current.y += (target.y - current.y) * .16;
      strength += (desiredStrength - strength) * (desiredStrength ? .13 : .08);
      render();
      const moving = Math.abs(target.x - current.x) + Math.abs(target.y - current.y) > .2 || Math.abs(desiredStrength - strength) > .003 || time < pulseUntil;
      frame = moving && visible ? requestAnimationFrame(tick) : 0;
      if (!frame && strength < .004) {
        strength = 0;
        render();
      }
    }

    function pulse(x = 650, y = 350) {
      target.x = x;
      target.y = y;
      pulseUntil = performance.now() + 360;
      wake();
    }

    liquidCover.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      pointerPosition(event);
      hovering = true;
      wake();
    });
    liquidCover.addEventListener('pointerleave', () => { hovering = false; wake(); });
    liquidCover.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'touch' || (event.target as Element).closest('a, button')) return;
      touchStart = { x: event.clientX, y: event.clientY, time: performance.now() };
    });
    liquidCover.addEventListener('pointerup', (event) => {
      if (!touchStart || event.pointerType !== 'touch') return;
      const distance = Math.hypot(event.clientX - touchStart.x, event.clientY - touchStart.y);
      const duration = performance.now() - touchStart.time;
      touchStart = undefined;
      if (distance > 12 || duration > 500) return;
      pointerPosition(event);
      pulse(target.x, target.y);
    });
    window.addEventListener('resize', () => { setResponsiveGeometry(); render(); });
    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden;
      if (!visible && frame) { cancelAnimationFrame(frame); frame = 0; }
      else wake();
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting && !document.hidden;
      if (!visible && frame) { cancelAnimationFrame(frame); frame = 0; }
      else wake();
    }).observe(liquidCover);

    setResponsiveGeometry();
    liquidCover.classList.add('is-liquid-ready');
  }
</script>
