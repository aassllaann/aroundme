---
const selectedWorks = [
  {
    index: '01',
    title: 'Photography Portfolio',
    type: 'PHOTOGRAPHY / PERSONAL ARCHIVE',
    href: '/works/photography-notes/',
    src: '/images/works/photography-notes/book/spread-03.jpg',
    alt: 'Photography Portfolio spread with water reflections and architecture',
    className: 'selected-work--photography',
  },
  {
    index: '02',
    title: 'Eye Study',
    type: 'SKETCHBOOK / PAINTING',
    href: '/sketchbook/',
    src: '/images/works/sketchbook/FREE_saywhateverI_7.jpg',
    alt: 'Sketchbook painting spread with a large blue eye and handwritten text',
    className: 'selected-work--eye',
  },
  {
    index: '03',
    title: 'Turn, Return',
    type: 'SKETCHBOOK / PAINTING',
    href: '/sketchbook/',
    src: '/images/works/sketchbook/FREE_saywhateverI_5.jpg',
    alt: 'Sketchbook painting spread with two painted figures on black',
    className: 'selected-work--turn',
  },
