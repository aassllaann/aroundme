---
import type { CollectionEntry } from 'astro:content';
import SiteNav from '../layout/SiteNav.astro';
import PhotographyFlipbook from './PhotographyFlipbook.astro';

interface Props {
  work: CollectionEntry<'works'>;
  Content: Awaited<ReturnType<typeof import('astro:content').render>>['Content'];
}

const { work, Content } = Astro.props;
const { preview } = work.data;
const assetUrl = (src: string) => `/${src}`;
const isPhotographyPortfolio = work.id === 'photography-notes';
const implementedPrototypeIds = new Set([
  'scentscape',
  'la-table-du-temps',
  'i-ching-grand-strategy',
  'agent-product-comparison',
]);
const hasImplementedPrototype = implementedPrototypeIds.has(work.id);
const projectStatus = isPhotographyPortfolio
  ? 'PORTFOLIO EDITION / 91 PAGES'
  : hasImplementedPrototype
    ? 'WORKING PROTOTYPE / SCREEN CAPTURES PENDING'
    : 'MATERIALS BEING INDEXED';
const previewCaption = isPhotographyPortfolio
  ? 'PORTFOLIO EDITION — OPENING PAGE'
  : hasImplementedPrototype && preview.type === 'image' && !preview.src.endsWith('.svg')
    ? 'PROJECT ILLUSTRATION / INTERFACE CAPTURES PENDING'
    : hasImplementedPrototype
      ? 'PROJECT PREVIEW / INTERFACE CAPTURES PENDING'
    : 'PROJECT PREVIEW — MATERIALS BEING INDEXED';
---

<main id="main-content" class="project-page">
  <header class="project-header">
    <a class="archive-home-link" href="/">LI YETONG / ASLAN</a>
    <SiteNav current="works" />
    <a href="/works/" class="project-back">← WORKS INDEX</a>
  </header>

  <section class="project-hero" aria-labelledby="project-title">
    <p class="archive-kicker"><span>FILE / {String(work.data.order).padStart(2, '0')}</span> {work.data.year} · {work.data.type}</p>
    <h1 id="project-title">{work.data.title}</h1>
    <p class="project-hero__summary">{work.data.summary}</p>
  </section>

  {!isPhotographyPortfolio && (
    <section class="project-media" aria-label={`${work.data.title} preview`}>
      <figure class="project-media__figure">
        {preview.type === 'image' ? (
          <img src={assetUrl(preview.src)} alt={preview.alt} />
        ) : (
          <video src={assetUrl(preview.src)} poster={assetUrl(preview.poster)} controls playsinline>
            Your browser does not support embedded video.
          </video>
        )}
        <figcaption>{previewCaption}</figcaption>
      </figure>
    </section>
  )}

  {isPhotographyPortfolio && <PhotographyFlipbook />}

  <section class="project-record">
    <aside class="project-meta" aria-label="Project metadata">
      <dl>
        <div><dt>TYPE</dt><dd>{work.data.type}</dd></div>
        <div><dt>YEAR</dt><dd>{work.data.year}</dd></div>
        <div><dt>INDEX</dt><dd>{work.data.categories.join(' · ')}</dd></div>
        <div><dt>STATUS</dt><dd>{projectStatus}</dd></div>
      </dl>
    </aside>
    <article class="project-body"><Content /></article>
  </section>

  <footer class="project-footer"><a href="/works/">← RETURN TO WORKS INDEX</a></footer>
</main>
