---
import type { CollectionEntry } from 'astro:content';
import SiteNav from '../layout/SiteNav.astro';
import PhotographyFlipbook from './PhotographyFlipbook.astro';

interface Props {
  work: CollectionEntry<'works'>;
  Content: Awaited<ReturnType<typeof import('astro:content').render>>['Content'];
}

const { work, Content } = Astro.props;
const isPhotographyPortfolio = work.id === 'photography-notes';
const isInterfaceCaseStudy = work.id === 'ai-camera-advisor';
const isScentscape = work.id === 'scentscape';
const isLaTableDuTemps = work.id === 'la-table-du-temps';
const isAgentProductComparison = work.id === 'agent-product-comparison';
const projectIndex = isInterfaceCaseStudy ? 'UI/UX' : work.data.categories.join(' · ');
---

<main id="main-content" class:list={['project-page', { 'project-page--interface-case-study': isInterfaceCaseStudy, 'project-page--scentscape': isScentscape, 'project-page--la-table-du-temps': isLaTableDuTemps, 'project-page--agent-product-comparison': isAgentProductComparison }]}>
  <header class="project-header">
    <a class="archive-home-link" href="/">LI YETONG / ASLAN</a>
    <SiteNav current="works" />
    <a href="/works/" class="project-back">← WORKS INDEX</a>
  </header>

  <section class="project-hero" aria-labelledby="project-title">
    <p class="archive-kicker"><span>FILE / {String(work.data.order).padStart(2, '0')}</span> {work.data.year} · {work.data.type}</p>
    <h1 id="project-title">{work.data.title}</h1>
    <p class="project-hero__summary">{work.data.summary}</p>
  </section>

  {isPhotographyPortfolio && <PhotographyFlipbook />}

  {!isPhotographyPortfolio && (
    <section class="project-record">
      <aside class="project-meta" aria-label="Project metadata">
        <dl>
          <div><dt>TYPE</dt><dd>{work.data.type}</dd></div>
          <div><dt>YEAR</dt><dd>{work.data.year}</dd></div>
          <div><dt>INDEX</dt><dd>{projectIndex}</dd></div>
        </dl>
      </aside>
      <article class="project-body"><Content /></article>
    </section>
  )}

  <footer class="project-footer"><a href="/works/">← RETURN TO WORKS INDEX</a></footer>
</main>
