---
import type { CollectionEntry } from 'astro:content';
import SiteNav from '../layout/SiteNav.astro';
import { workCategories, worksInCategory } from '../../data/work-categories.js';

interface Props {
  works: CollectionEntry<'works'>[];
  embedded?: boolean;
}

const { works, embedded = false } = Astro.props;
const Root = embedded ? 'section' : 'main';
---

<Root id={embedded ? 'works' : 'main-content'} class:list={['works-page', 'works-landing', { 'works-page--embedded': embedded }]} aria-labelledby={embedded ? 'works-title' : undefined}>
  <header class="works-header">
    <a class="archive-home-link" href="/">LI YETONG / ASLAN</a>
    <SiteNav current="works" worksHref={embedded ? '#works' : '/works/'} />
    <p class="edition-mark edition-mark--right">{String(works.length).padStart(2, '0')} PROJECTS</p>
  </header>

  <section class="works-intro" aria-labelledby="works-title">
    <p class="archive-kicker"><span>WORKS</span> SYSTEMS / IMAGES / STORIES</p>
    <h1 id="works-title">WORKS</h1>
    <p>Choose a field, then enter the work.<br /><a class="works-projector-link" href="/lab/projector/">OPEN THE UNRELIABLE PROJECTOR ↗</a></p>
  </section>

  <nav class="works-category-index" aria-label="Work collections">
    {workCategories.map((category, index) => {
      const count = worksInCategory(works, category).length;
      return (
        <a class={`works-category-tile works-category-tile--${index + 1}`} href={`/works/${category.id}/`}>
          <span class="works-category-tile__meta">{String(index + 1).padStart(2, '0')} / {String(count).padStart(2, '0')}</span>
          <span class="works-category-tile__title">{category.label}</span>
          <span class="works-category-tile__arrow" aria-hidden="true">↗</span>
        </a>
      );
    })}
  </nav>

  <footer class="works-landing__footer"><a href="/sketchbook/">OPEN SKETCHBOOK ↗</a></footer>
</Root>
