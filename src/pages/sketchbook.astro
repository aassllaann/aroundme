---
import { existsSync, readdirSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/layout/SiteNav.astro';
import '../styles/archive-b.css';
import '../styles/sketchbook-browser.css';

const imageExtension = /\.(avif|gif|jpe?g|png|svg|webp)$/i;
const sketchbookDirectory = `${process.cwd()}/public/images/works/sketchbook`;
const imageDescriptions: Record<string, string> = {
  '00-task1-1.jpg': 'Black-ink character sketches with handwritten notes: an octopus, fishbone, wrench creature, manta, archer, chain creature, and headless figure.',
  '01-task1-2.jpg': 'Black-ink character sketches with handwritten notes: an eyeball juggler, rat boss, cat soldier, fractured fingers, horse, and three swords.',
  'FREE_saywhateverI_2.jpg': 'Watercolor sketchbook spread with a horse-like figure, a grey figure with large eyes, and handwritten text.',
  'FREE_saywhateverI_4.jpg': 'Sketchbook spread with orange Choose Life lettering, a blue pool-like shape, and handwritten notes.',
  'FREE_saywhateverI_5.jpg': 'Black sketchbook spread with green and red figures kissing and orange handwritten text.',
  'FREE_saywhateverI_7.jpg': 'Red sketchbook spread with a large painted blue eye and orange handwritten text.',
  'FREE_saywhateverI_8.jpg': 'Black sketchbook spread with repeated green lettering and loosely drawn figures.',
  'IMG_4772.JPG': 'Pale blue and yellow sketchbook spread with stylized airplanes, a window view, and handwritten Chinese notes.',
  'retouch_2025120817385656.jpg': 'Purple-bordered sketchbook spread with pink and purple painted forms and bilingual handwriting.',
  'retouch_2025120817401618.jpg': 'Pink-bordered sketchbook spread with a purple horse, translucent flowers, and scattered words.',
  'retouch_2025121214130179.jpg': 'Deep blue sketchbook spread with painted figures, a chair, an eye, and Chinese characters.',
  'retouch_2025121214150612.jpg': 'Cyan-bordered sketchbook spread with a large blue oval form and handwritten text.',
  '□HH.jpg': 'Black sketchbook spread with a bright yellow bird-like form, a blue wing, a red heart, and a green hand.',
  'はa心王_noshu.jpg': 'Pale sketchbook spread with a blue-green oval form and handwritten text about being in the ocean.',
};
const images = existsSync(sketchbookDirectory)
  ? readdirSync(sketchbookDirectory)
      .filter((filename: string) => imageExtension.test(filename))
      .sort((a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0))
      .map((filename: string) => ({
        src: `/images/works/sketchbook/${encodeURIComponent(filename)}`,
        alt: imageDescriptions[filename] ?? filename.replace(imageExtension, '').replaceAll(/[-_]/g, ' '),
      }))
  : [];
---

<BaseLayout title="Sketchbook — Li Yetong" page="works">
  <main id="main-content" class="sketchbook-page">
    <header class="works-header">
      <a class="archive-home-link" href="/">LI YETONG / ASLAN</a>
      <SiteNav current="sketchbook" />
      <p class="edition-mark edition-mark--right">IMAGE NOTES / {String(images.length).padStart(2, '0')}</p>
    </header>

    <section class="sketchbook-intro" aria-labelledby="sketchbook-title">
      <p class="archive-kicker"><span>03</span> UNCLASSIFIED IMAGE FILES</p>
      <h1 id="sketchbook-title">SKETCHBOOK</h1>
      <p>Loose visual notes, pixel studies, fragments, and experiments.</p>
      {images.length > 0 && (
        <div class="sketchbook-view-controls" role="group" aria-label="Sketchbook view">
          <button type="button" data-sketchbook-view="overview" aria-pressed="true">OVERVIEW</button>
          <button type="button" data-sketchbook-view="single" aria-pressed="false">ONE AT A TIME</button>
        </div>
      )}
    </section>

    {images.length > 0 ? (
      <section class="sketchbook-overview" data-sketchbook-overview aria-label="Sketchbook overview">
        {images.map((image: { src: string; alt: string }, index: number) => (
          <figure class="sketchbook-image" id={`sketchbook-file-${index + 1}`}>
            <button type="button" class="sketchbook-image__open" data-sketchbook-open aria-label={`Open image ${index + 1} of ${images.length}`}>
              <img src={image.src} alt={image.alt} loading={index < 3 ? 'eager' : 'lazy'} />
            </button>
            <figcaption>FILE / {String(index + 1).padStart(2, '0')}</figcaption>
          </figure>
        ))}
      </section>
      <section class="sketchbook-single" data-sketchbook-single hidden aria-label="Single sketchbook image">
        <p class="sketchbook-single__counter" data-sketchbook-single-counter>FILE / 01 OF {String(images.length).padStart(2, '0')}</p>
        <button type="button" class="sketchbook-single__image" data-sketchbook-single-open aria-label={`Open image 1 of ${images.length}`}>
          <img data-sketchbook-single-image src={images[0].src} alt={images[0].alt} />
        </button>
        <div class="sketchbook-single__controls" aria-label="Single image controls">
          <button type="button" data-sketchbook-single-previous disabled>← PREVIOUS</button>
          <button type="button" data-sketchbook-single-overview>RETURN TO OVERVIEW</button>
          <button type="button" data-sketchbook-single-next>NEXT →</button>
        </div>
      </section>
    ) : (
      <section class="sketchbook-empty" aria-label="Sketchbook pending images">
        <p>IMAGE FILES PENDING</p>
        <p>Add image files to <code>public/images/works/sketchbook/</code>.</p>
      </section>
    )}

    <footer class="project-footer"><a href="/works/">← RETURN TO WORKS INDEX</a></footer>
  </main>

  <dialog class="sketchbook-lightbox" data-sketchbook-lightbox aria-label="Expanded sketchbook image" inert>
    <button type="button" class="sketchbook-lightbox__close" data-sketchbook-close aria-label="Close expanded image">×</button>
    <button type="button" class="sketchbook-lightbox__previous" data-sketchbook-previous aria-label="Previous image">←</button>
    <figure class="sketchbook-lightbox__frame">
      <img data-sketchbook-lightbox-image src="" alt="" />
      <figcaption data-sketchbook-lightbox-caption>FILE / 00</figcaption>
    </figure>
    <button type="button" class="sketchbook-lightbox__next" data-sketchbook-next aria-label="Next image">→</button>
  </dialog>
</BaseLayout>

<script>
  document.documentElement.classList.add('has-js');
  const galleryImages = Array.from(document.querySelectorAll<HTMLImageElement>('[data-sketchbook-open] img'));
  const openButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sketchbook-open]'));
  const lightbox = document.querySelector<HTMLDialogElement>('[data-sketchbook-lightbox]');
  const lightboxImage = document.querySelector<HTMLImageElement>('[data-sketchbook-lightbox-image]');
  const lightboxCaption = document.querySelector<HTMLElement>('[data-sketchbook-lightbox-caption]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-sketchbook-close]');
  const previousButton = document.querySelector<HTMLButtonElement>('[data-sketchbook-previous]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-sketchbook-next]');
  const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sketchbook-view]'));
  const overview = document.querySelector<HTMLElement>('[data-sketchbook-overview]');
  const single = document.querySelector<HTMLElement>('[data-sketchbook-single]');
  const singleImage = document.querySelector<HTMLImageElement>('[data-sketchbook-single-image]');
  const singleCounter = document.querySelector<HTMLElement>('[data-sketchbook-single-counter]');
  const singleOpenButton = document.querySelector<HTMLButtonElement>('[data-sketchbook-single-open]');
  const singlePrevious = document.querySelector<HTMLButtonElement>('[data-sketchbook-single-previous]');
  const singleNext = document.querySelector<HTMLButtonElement>('[data-sketchbook-single-next]');
  const overviewButton = document.querySelector<HTMLButtonElement>('[data-sketchbook-single-overview]');
  let activeIndex = 0;
  let activeView: 'overview' | 'single' = 'overview';
  let swipeStartX = 0;
  let triggeringButton: HTMLButtonElement | undefined;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setActiveIndex(index: number) {
    if (galleryImages.length === 0) return;
    const previousIndex = activeIndex;
    activeIndex = Math.max(0, Math.min(index, galleryImages.length - 1));
    const image = galleryImages[activeIndex];
    if (singleImage) {
      singleImage.src = image.currentSrc || image.src;
      singleImage.alt = image.alt;
      if (!reduceMotion && activeIndex !== previousIndex) {
        singleImage.animate([{ opacity: .6 }, { opacity: 1 }], { duration: 180, easing: 'cubic-bezier(.2, 0, 0, 1)' });
      }
    }
    if (singleCounter) singleCounter.textContent = `FILE / ${String(activeIndex + 1).padStart(2, '0')} OF ${String(galleryImages.length).padStart(2, '0')}`;
    if (singleOpenButton) singleOpenButton.setAttribute('aria-label', `Open image ${activeIndex + 1} of ${galleryImages.length}`);
    if (singlePrevious) singlePrevious.disabled = activeIndex === 0;
    if (singleNext) singleNext.disabled = activeIndex === galleryImages.length - 1;
  }

  function showImage(index: number) {
    if (!lightboxImage || !lightboxCaption || galleryImages.length === 0) return;
    setActiveIndex(index);
    const image = galleryImages[activeIndex];
    lightboxImage.src = image.currentSrc || image.src;
    lightboxImage.alt = image.alt;
    lightboxCaption.textContent = `FILE / ${String(activeIndex + 1).padStart(2, '0')}`;
    if (previousButton) previousButton.disabled = activeIndex === 0;
    if (nextButton) nextButton.disabled = activeIndex === galleryImages.length - 1;
  }

  function openLightbox(index: number, trigger?: HTMLButtonElement) {
    if (!lightbox) return;
    triggeringButton = trigger ?? openButtons[index];
    showImage(index);
    lightbox.inert = false;
    if (!lightbox.open) lightbox.showModal();
    closeButton?.focus();
  }

  function setView(view: 'overview' | 'single') {
    activeView = view;
    if (overview) overview.hidden = view !== 'overview';
    if (single) single.hidden = view !== 'single';
    viewButtons.forEach((button) => {
      const active = button.dataset.sketchbookView === view;
      button.setAttribute('aria-pressed', String(active));
    });
    setActiveIndex(activeIndex);
  }

  function closeLightbox() {
    if (lightbox?.open) lightbox.close();
  }

  openButtons.forEach((button, index) => button.addEventListener('click', () => openLightbox(index, button)));
  viewButtons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.sketchbookView === 'single' ? 'single' : 'overview')));
  singleOpenButton?.addEventListener('click', () => openLightbox(activeIndex, singleOpenButton));
  singlePrevious?.addEventListener('click', () => setActiveIndex(activeIndex - 1));
  singleNext?.addEventListener('click', () => setActiveIndex(activeIndex + 1));
  overviewButton?.addEventListener('click', () => setView('overview'));
  closeButton?.addEventListener('click', closeLightbox);
  previousButton?.addEventListener('click', () => showImage(activeIndex - 1));
  nextButton?.addEventListener('click', () => showImage(activeIndex + 1));

  document.addEventListener('keydown', (event) => {
    if (lightbox?.open) {
      if (event.key === 'ArrowLeft') { event.preventDefault(); showImage(activeIndex - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); showImage(activeIndex + 1); }
      return;
    }
    const target = event.target as HTMLElement | null;
    const editing = target?.matches('input, textarea, select, [contenteditable="true"]');
    if (activeView !== 'single' || editing) return;
    if (event.key === 'ArrowLeft' && activeIndex > 0) { event.preventDefault(); setActiveIndex(activeIndex - 1); }
    if (event.key === 'ArrowRight' && activeIndex < galleryImages.length - 1) { event.preventDefault(); setActiveIndex(activeIndex + 1); }
  });

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  lightbox?.addEventListener('close', () => {
    lightbox.inert = true;
    triggeringButton?.focus();
    triggeringButton = undefined;
  });
  lightbox?.addEventListener('pointerdown', (event) => { swipeStartX = event.clientX; });
  lightbox?.addEventListener('pointerup', (event) => {
    const distance = event.clientX - swipeStartX;
    if (Math.abs(distance) < 48) return;
    showImage(distance < 0 ? activeIndex + 1 : activeIndex - 1);
  });

  setActiveIndex(0);
</script>
