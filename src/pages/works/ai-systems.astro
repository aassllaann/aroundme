---
import { getCollection } from 'astro:content';
import WorkCategoryGallery from '../../components/works/WorkCategoryGallery.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorkCategory } from '../../data/work-categories.js';
import '../../styles/archive-b.css';

const category = getWorkCategory('ai-systems');
const works = (await getCollection('works')).filter((work) => work.data.categories.includes(category.contentCategory)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="AI Systems — Aslan Li" page="works"><WorkCategoryGallery {category} {works} /></BaseLayout>
