---
import { getCollection } from 'astro:content';
import WorkCategoryGallery from '../../components/works/WorkCategoryGallery.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/archive-b.css';

const category = { id: 'image-studies', label: 'Image Studies', contentCategory: 'Image Studies', intro: 'Illustrated manuals and visual experiments retained from the earlier archive.' };
const works = (await getCollection('works')).filter((work) => work.data.categories.includes(category.contentCategory)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Image Studies — Aslan Li" page="works"><WorkCategoryGallery {category} {works} /></BaseLayout>
