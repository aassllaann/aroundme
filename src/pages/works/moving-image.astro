---
import { getCollection } from 'astro:content';
import WorkCategoryGallery from '../../components/works/WorkCategoryGallery.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/archive-b.css';

const category = { id: 'moving-image', label: 'Moving Image', contentCategory: 'Moving Image', intro: 'Editing studies and moving-image fragments retained in the archive.' };
const works = (await getCollection('works')).filter((work) => work.data.categories.includes(category.contentCategory)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Moving Image — Aslan Li" page="works"><WorkCategoryGallery {category} {works} /></BaseLayout>
